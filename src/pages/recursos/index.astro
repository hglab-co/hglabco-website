---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/blog';
import ArticleCard from '../../components/ArticleCard.astro';

const posts = await getBlogPosts();
const resources = posts.filter((post) => post.data.pdf || ['el-com-primero'].includes(post.id));
---

<BaseLayout
	title="Recursos"
	description="Guias y recursos descargables de Hugo Garcia para construir negocios."
>
	<section class="page-section listing-page">
		<div class="section-inner">
			<header class="listing-header">
				<h1 class="title-hero">Recursos<span class="dot-yellow">.</span></h1>
				<p class="internal-lead">
					Plantillas, guias y marcos de trabajo. Por ahora viven conectados a los
					articulos donde se explican.
				</p>
			</header>
			<div class="article-grid">
				{resources.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>
