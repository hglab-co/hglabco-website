---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/blog';

const posts = await getBlogPosts();
const resources = posts.filter((post) => post.data.pdf || ['el-com-primero'].includes(post.id));
---

<BaseLayout
	title="Recursos"
	description="Guias y recursos descargables de Hugo Garcia para construir negocios."
>
	<section class="reeni-page-hero">
		<div class="reeni-shell">
			<span class="section-kicker">Home / Recursos</span>
			<h1>Recursos<span class="dot-yellow">.</span></h1>
			<p>Guias, frameworks y herramientas conectadas a historias reales.</p>
		</div>
	</section>

	<section class="reeni-section resources-page">
		<div class="reeni-shell">
			<div class="project-grid">
				{resources.map((post) => (
					<a class="project-card" href={`/blog/${post.id}/`}>
						<img src={post.data.image} alt="" width="1200" height="675" loading="lazy" />
						<div>
							<span>{post.data.pillar}</span>
							<h2>{post.data.title}</h2>
							<p>{post.data.excerpt}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
