---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina no encontrada" description="Esta pagina no existe." noindex>
	<section class="page-shell">
		<p class="eyebrow">404</p>
		<h1>Pagina no encontrada.</h1>
		<p class="lead">
			La ruta que abriste no existe o fue movida. Puedes volver al home o revisar
			el blog.
		</p>
		<p>
			<a class="text-link" href="/">Volver al home</a>
		</p>
	</section>
</BaseLayout>
