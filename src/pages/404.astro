---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina no encontrada" description="Esta pagina no existe." noindex>
	<section class="page-section internal-hero">
		<div class="section-inner">
		<p class="article-badge">404</p>
		<h1 class="title-hero">Pagina no encontrada<span class="dot-yellow">.</span></h1>
		<p class="internal-lead">
			La ruta que abriste no existe o fue movida. Puedes volver al home o revisar
			el blog.
		</p>
		<p>
			<a class="btn-primary" href="/">Volver al home</a>
		</p>
		</div>
	</section>
</BaseLayout>
