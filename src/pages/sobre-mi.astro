---
import BaseLayout from '../layouts/BaseLayout.astro';
import Highlight from '../components/Highlight.astro';
import SignatureBlock from '../components/SignatureBlock.astro';
---

<BaseLayout
	title="Sobre mi"
	description="La historia de Hugo Garcia, fundador de QPayPro y constructor de negocios en LATAM."
>
	<section class="reeni-page-hero">
		<div class="reeni-shell">
			<span class="section-kicker">Home / Sobre mi</span>
			<h1>About me<span class="dot-yellow">.</span></h1>
		</div>
	</section>

	<section class="reeni-section about-profile">
		<div class="reeni-shell about-profile__grid">
			<div class="about-profile__image">
				<img src="/img/hugo-garcia.jpeg" alt="Hugo Garcia" width="900" height="1200" />
			</div>
			<div class="about-profile__content">
				<span class="section-kicker">Hugo Garcia</span>
				<h2>Estrategia, tecnologia y experiencia real para crecer<span class="dot-yellow">.</span></h2>
				<p>
					Tengo 42 anos y llevo 9 anos construyendo QPayPro, una pasarela de pagos
					fintech para LATAM. Pero mi historia no empezo ahi.
				</p>
				<p>
					Antes de QPayPro recorri distintos modelos de negocio: cafeteria,
					software, productos fisicos, ecommerce y asesorias. Algunos evolucionaron,
					otros cumplieron su ciclo, pero todos me dejaron experiencia real sobre
					ventas, socios, operacion, caja, clientes y decisiones dificiles.
				</p>
				<p>
					<Highlight>Trabajo desde la cancha.</Highlight> Comparto aprendizajes,
					herramientas y estrategias para emprendedores y empresas que quieren
					crecer con mas criterio.
				</p>
				<SignatureBlock class="about-profile__signature" />
			</div>
		</div>
	</section>

	<section class="reeni-section about-stats-section">
		<div class="reeni-shell">
			<div class="about-stats-grid">
				<article><strong>9+</strong><span>anos con QPayPro</span></article>
				<article><strong>6+</strong><span>modelos de negocio recorridos</span></article>
				<article><strong>LATAM</strong><span>mercado, pagos y operaciones</span></article>
				<article><strong>2</strong><span>socios en casa: Mariana y yo</span></article>
			</div>
		</div>
	</section>

	<section class="reeni-section skills-section">
		<div class="reeni-shell skills-grid">
			<div>
				<span class="section-kicker">Design skill</span>
				<h2>Como pienso<span class="dot-yellow">.</span></h2>
				{[
					['Validacion de negocio', '95%'],
					['Ventas tempranas', '90%'],
					['Narrativa de producto', '88%'],
					['Decisiones estrategicas', '82%'],
				].map(([label, value]) => (
					<div class="skill-line">
						<div><span>{label}</span><strong>{value}</strong></div>
						<i style={`--value: ${value}`}></i>
					</div>
				))}
			</div>
			<div>
				<span class="section-kicker">Development skill</span>
				<h2>Como opero<span class="dot-yellow">.</span></h2>
				{[
					['Datos y tableros', '92%'],
					['Fintech / pagos', '90%'],
					['IA aplicada', '80%'],
					['Equipo y liderazgo', '86%'],
				].map(([label, value]) => (
					<div class="skill-line">
						<div><span>{label}</span><strong>{value}</strong></div>
						<i style={`--value: ${value}`}></i>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="reeni-section experience-section">
		<div class="reeni-shell">
			<div class="section-head">
				<span class="section-kicker">Experiences</span>
				<h2>Negocios recorridos<span class="dot-yellow">.</span></h2>
			</div>
			<div class="experience-list">
				{[
					['01', 'Guafres', 'Cafeteria', 'Experiencia previa'],
					['02', 'Software con socio', 'Producto digital', 'Ciclo completado'],
					['03', 'Plackit', 'Organizacion y productos fisicos', 'En pausa'],
					['04', 'Sublimacion', 'Producto fisico', 'Experiencia previa'],
					['05', 'Juguetes', 'Comercio', 'Proyecto recorrido'],
					['06', 'QPayPro', 'Fintech LATAM', 'En operacion'],
				].map(([number, name, description, status]) => (
					<article class="experience-card">
						<span>{number}</span>
						<div>
							<h3>{name}</h3>
							<p>{description}</p>
						</div>
						<strong>{status}</strong>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="reeni-section closing-letter">
		<div class="reeni-shell">
			<div class="quote-card">
				<blockquote>
					La experiencia sirve cuando se convierte en criterio, herramientas y
					decisiones mejor tomadas.
				</blockquote>
				<SignatureBlock class="closing-letter__signature" />
			</div>
		</div>
	</section>
</BaseLayout>
