---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, getCategories, getCategoryUrl } from '../../lib/blog';

const posts = await getBlogPosts();
const categories = getCategories(posts);
---

<BaseLayout
	title="Blog"
	description="Historias y aprendizajes de Hugo Garcia sobre construir negocios en LATAM."
>
	<section class="reeni-page-hero">
		<div class="reeni-shell">
			<span class="section-kicker">Home / Blog</span>
			<h1>Blog<span class="dot-yellow">.</span></h1>
			<p>Historias y aprendizajes de negocios, datos, socios, tecnologia y reinvencion.</p>
		</div>
	</section>

	<section class="reeni-section listing-page">
		<div class="reeni-shell">
			{
				categories.length > 0 && (
					<nav class="filter-chips" aria-label="Filtrar por pilar">
						<a class="filter-chip filter-chip--active" href="/blog">Todos</a>
						{categories.map((category) => (
							<a class="filter-chip" href={getCategoryUrl(category.name)}>
								{category.name}
							</a>
						))}
					</nav>
				)
			}

			<div class="article-grid article-grid--blog">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>
