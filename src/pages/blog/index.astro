---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, getCategories, getCategoryUrl } from '../../lib/blog';

const posts = await getBlogPosts();
const categories = getCategories(posts);
---

<BaseLayout
	title="Blog"
	description="Historias y aprendizajes de Hugo Garcia sobre construir negocios en LATAM."
>
	<section class="page-section listing-page">
		<div class="section-inner">
			<header class="listing-header">
				<h1 class="title-hero">
					Historias y aprendizajes<span class="dot-yellow">.</span>
				</h1>
				<p class="internal-lead">
					Lo que aprendi construyendo, operando, cerrando y volviendo a empezar.
				</p>
			</header>

			{
				categories.length > 0 && (
					<nav class="filter-chips" aria-label="Filtrar por pilar">
						<a class="filter-chip filter-chip--active" href="/blog">Todos</a>
						{categories.map((category) => (
							<a class="filter-chip" href={getCategoryUrl(category.name)}>
								{category.name}
							</a>
						))}
					</nav>
				)
			}

			<div class="article-grid">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>

			<nav class="pagination-simple" aria-label="Paginacion">
				<span>Pagina 1</span>
				<a href="/blog">Siguiente -></a>
			</nav>
		</div>
	</section>
</BaseLayout>
