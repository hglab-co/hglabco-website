---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { formatDate, getBlogPosts, getPostUrl } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getBlogPosts();

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = post.data.seoTitle ?? post.data.title;
const description = post.data.seoDescription ?? post.data.description;
const postUrl = new URL(getPostUrl(post), siteConfig.url).toString();
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: new URL(post.data.image ?? siteConfig.socialImage, siteConfig.url).toString(),
	datePublished: post.data.pubDate.toISOString(),
	dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
	inLanguage: siteConfig.language,
	author: {
		'@type': 'Person',
		name: siteConfig.author,
		url: siteConfig.url,
	},
	mainEntityOfPage: postUrl,
};
---

<BaseLayout
	title={title}
	description={description}
	image={post.data.image}
	type="article"
	canonical={getPostUrl(post)}
>
	<article class="article-shell">
		<p class="eyebrow">{post.data.category}</p>
		<h1>{post.data.title}</h1>
		<div class="post-meta">
			<time datetime={post.data.pubDate.toISOString()}>
				{formatDate(post.data.pubDate)}
			</time>
			{
				post.data.updatedDate && (
					<>
						<span aria-hidden="true">/</span>
						<span>Actualizado {formatDate(post.data.updatedDate)}</span>
					</>
				)
			}
		</div>
		<div class="article-content">
			<Content />
		</div>
	</article>
	<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>
