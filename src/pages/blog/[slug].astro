---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { siteConfig } from '../../config/site';
import { getBlogPosts, getPostUrl } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getBlogPosts();

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = post.data.seoTitle ?? post.data.title;
const description = post.data.seoDescription ?? post.data.description;
const canonical = new URL(getPostUrl(post), siteConfig.url).toString();
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: new URL(post.data.image ?? siteConfig.socialImage, siteConfig.url).toString(),
	datePublished: post.data.pubDate.toISOString(),
	dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
	inLanguage: siteConfig.language,
	author: {
		'@type': 'Person',
		name: siteConfig.author,
		url: siteConfig.url,
	},
	mainEntityOfPage: canonical,
};
---

<ArticleLayout post={post} title={title} description={description} canonical={getPostUrl(post)}>
	<Content />
	<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</ArticleLayout>
