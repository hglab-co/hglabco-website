---
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPosts, getCategories } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	const categories = getCategories(posts);

	return categories.map((category) => ({
		params: { category: category.slug },
		props: {
			category,
			posts: posts.filter((post) => post.data.category === category.name),
		},
	}));
}

const { category, posts } = Astro.props;
---

<BaseLayout
	title={`Pilar: ${category.name}`}
	description={`Historias de Hugo Garcia sobre ${category.name}.`}
>
	<section class="page-section listing-page">
		<div class="section-inner">
			<header class="listing-header">
				<a class="filter-chip" href="/blog">Todos los articulos</a>
				<h1 class="title-hero">{category.name}<span class="dot-yellow">.</span></h1>
				<p class="internal-lead">
					{category.count} {category.count === 1 ? 'historia publicada' : 'historias publicadas'} en este pilar.
				</p>
			</header>

			<div class="article-grid">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>
