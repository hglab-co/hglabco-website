---
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPosts, getCategories } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	const categories = getCategories(posts);

	return categories.map((category) => ({
		params: { category: category.slug },
		props: {
			category,
			posts: posts.filter((post) => post.data.category === category.name),
		},
	}));
}

const { category, posts } = Astro.props;
---

<BaseLayout
	title={`Pilar: ${category.name}`}
	description={`Historias de Hugo Garcia sobre ${category.name}.`}
>
	<section class="reeni-page-hero">
		<div class="reeni-shell">
			<span class="section-kicker">Blog / Pilar</span>
			<h1>{category.name}<span class="dot-yellow">.</span></h1>
			<p>
				{category.count} {category.count === 1 ? 'historia publicada' : 'historias publicadas'} en este pilar.
			</p>
		</div>
	</section>

	<section class="reeni-section listing-page">
		<div class="reeni-shell">
			<nav class="filter-chips" aria-label="Volver al blog">
				<a class="filter-chip" href="/blog">Todos los articulos</a>
			</nav>
			<div class="article-grid article-grid--blog">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>
