---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
	title="Contacto"
	description="Contacta a Hugo Garcia para conversaciones, colaboraciones o mensajes directos."
>
	<section class="reeni-page-hero">
		<div class="reeni-shell">
			<span class="section-kicker">Home / Contacto</span>
			<h1>Contacto<span class="dot-yellow">.</span></h1>
			<p>Si tienes una idea, una pregunta o una conversacion pendiente, escribeme.</p>
		</div>
	</section>

	<section class="reeni-section contact-page">
		<div class="reeni-shell contact-grid">
			<div class="contact-info-card">
				<span class="section-kicker">Get in touch</span>
				<h2>Hablemos de negocios reales<span class="dot-yellow">.</span></h2>
				<p>
					Fintech, pagos, operaciones, IA aplicada, sociedades, ventas tempranas o
					decisiones dificiles. Esa es mi cancha.
				</p>
				<div class="contact-links">
					<a href={siteConfig.social.instagram}>Instagram DM</a>
					<a href="mailto:hola@hglab.co">hola@hglab.co</a>
					<a href={siteConfig.social.linkedin}>LinkedIn</a>
				</div>
			</div>
			<form class="contact-form" action="mailto:hola@hglab.co" method="post" enctype="text/plain">
				<label>
					<span>Nombre</span>
					<input name="nombre" autocomplete="name" required />
				</label>
				<label>
					<span>Mensaje</span>
					<textarea name="mensaje" rows="7" required></textarea>
				</label>
				<button class="btn-primary btn-pill" type="submit">Enviar mensaje -></button>
			</form>
		</div>
	</section>
</BaseLayout>
