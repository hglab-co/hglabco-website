---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Highlight from '../components/Highlight.astro';
import SignatureBlock from '../components/SignatureBlock.astro';
import { contentPillars, siteConfig } from '../config/site';
import { getBlogPosts } from '../lib/blog';

const posts = (await getBlogPosts()).slice(0, 6);
---

<BaseLayout title="Home" description={siteConfig.description}>
	<section class="reeni-hero" aria-labelledby="hero-title">
		<div class="reeni-shell">
			<div class="hero-layout">
				<div class="hero-copy">
					<span class="section-kicker">Hugo Garcia / hglab.co</span>
					<h1 id="hero-title">
						Construyo, opero y escalo negocios reales<span class="dot-yellow">.</span>
					</h1>
					<p>
						Comparto aprendizajes, herramientas y estrategias desde la experiencia
						de crear empresas, liderar equipos y tomar decisiones en la cancha.
					</p>
					<div class="hero-buttons">
						<a class="btn-primary btn-pill" href="/blog">Leer aprendizajes</a>
						<a class="btn-soft" href="/recursos">Ver recursos</a>
						<a class="btn-soft" href="/contacto">Solicitar asesoria</a>
					</div>
				</div>
				<div class="hero-visual">
					<div class="hero-photo-card">
						<img src="/img/hugo-garcia.jpeg" alt="Hugo Garcia" width="900" height="1200" />
						<img
							class="hero-monogram"
							src="/img/logo-monogram@2x.png"
							alt=""
							width="1024"
							height="1024"
						/>
					</div>
					<div class="hero-stat-card">
						<strong>9+</strong>
						<span>anos operando QPayPro</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="reeni-section intro-card-section" aria-labelledby="intro-title">
		<div class="reeni-shell">
			<div class="intro-card">
				<div>
					<span class="section-kicker">Personal brand concept</span>
					<h2 id="intro-title">Hola, soy Hugo<span class="dot-yellow">.</span></h2>
				</div>
				<p>
					Soy fundador y CEO de <Highlight>QPayPro</Highlight>, consultor de negocios,
					estratega y creador de contenido. Me interesa hablar de ventas,
					operacion, datos, tecnologia, IA, liderazgo y crecimiento desde experiencia
					real.
				</p>
				<SignatureBlock class="intro-card__signature" />
			</div>
		</div>
	</section>

	<section class="reeni-section" aria-labelledby="pillars-title">
		<div class="reeni-shell">
			<div class="section-head">
				<span class="section-kicker">Servicios editoriales</span>
				<h2 id="pillars-title">6 pilares de contenido<span class="dot-yellow">.</span></h2>
			</div>
			<div class="service-grid">
				{
					contentPillars.map((pillar) => (
						<article class="service-card">
							<span>{pillar.number}</span>
							<h3>{pillar.title}</h3>
							<p>{pillar.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="reeni-section latest-work" aria-labelledby="latest-title">
		<div class="reeni-shell">
			<div class="section-head section-head--split">
				<div>
					<span class="section-kicker">Blog</span>
					<h2 id="latest-title">Historias recientes<span class="dot-yellow">.</span></h2>
				</div>
				<a class="btn-soft" href="/blog">Ver blog</a>
			</div>
			<div class="article-grid article-grid--reeni">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<section class="reeni-section manifesto-preview" aria-labelledby="manifesto-title">
		<div class="reeni-shell">
			<div class="manifesto-card">
				<img src="/img/logo-monogram@2x.png" alt="" width="1024" height="1024" />
				<div>
					<span class="section-kicker">Manifiesto</span>
					<h2 id="manifesto-title">
						Aprendizajes reales para vender, operar, liderar y tomar mejores decisiones.
					</h2>
					<a class="btn-primary btn-pill" href="/manifiesto">Leer manifiesto</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
